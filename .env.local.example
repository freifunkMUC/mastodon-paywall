API_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
# Use https://api-m.sandbox.paypal.com for testing against a PayPal sandbox account.
PAYPAL_API_BASE=https://api-m.paypal.com
# Required to auto-disable accounts when a subscription is cancelled/expires.
# Create a webhook in the PayPal developer dashboard pointing at
# https://<your-domain>/api/webhooks/paypal and paste its ID here.
PAYPAL_WEBHOOK_ID=
# Optional, defaults to a local sqlite file at ./data/paywall.sqlite3.
# Also accepts postgres://user:pass@host:5432/db or mysql://user:pass@host:3306/db.
DATABASE_URL=