# @hookform/resolvers declares ~25 optional peerDependencies (ajv, zod, joi, ...)
# for validator libraries we don't use. npm's strict peer-dep resolution tries
# to reconcile the optional "ajv" peer against eslint's real (incompatible)
# ajv@6.x dependency and produces a non-deterministic package-lock.json as a
# result, which then fails `npm ci` with "Missing: ... from lock file" errors
# that vary between runs/npm versions. legacy-peer-deps avoids that reconciliation.
legacy-peer-deps=true
